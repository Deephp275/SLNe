NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: a webhook (Slack/Discord/Zapier/Make) that receives a JSON POST for each new enquiry
ENQUIRY_WEBHOOK_URL=
# Local-only mode, FIRST RUN ONLY: the starting admin password. It is stored hashed in data/auth.json on first login,`n# then delete this line (change the password later in Admin > Account & Security).`nLOCAL_ADMIN_PASSWORD=`n
# Server settings (all optional)
# HOST=127.0.0.1        this computer only (default). 0.0.0.0 shares the public site on your network
# TRUST_PROXY=0         set 1 ONLY behind your own HTTPS proxy that sets X-Forwarded-For / X-Forwarded-Proto itself
